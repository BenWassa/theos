---
import type { CollectionEntry } from 'astro:content';
import SectionMeta from '../SectionMeta.astro';
import LensLabel from '../LensLabel.astro';
type Props = {
  data: CollectionEntry<'traditions'>['data'];
};
const { data } = Astro.props;
---

<div class="immersive reveal">
  <div class="panel">
    {data.lens && <LensLabel lens={data.lens} />}
    <div class="prose">
      <slot />
    </div>
    <SectionMeta data={data} />
  </div>
</div>

<style>
  .immersive {
    position: relative;
    padding-block: clamp(1.5rem, 4vh, 3rem);
  }
  .panel {
    position: relative;
    max-width: var(--measure);
    margin: 0 auto;
  }
  .prose {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(1.3rem, 1.1rem + 1.1vw, 1.9rem);
    line-height: 1.55;
    letter-spacing: -0.01em;
  }
  .prose :global(p) {
    margin-bottom: 1.5rem;
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(em) {
    font-style: italic;
    color: var(--accent);
  }
</style>

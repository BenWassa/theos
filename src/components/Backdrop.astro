---
// Generative, image-free atmosphere driven entirely by palette tokens.
// `pattern` picks the character; 'geometric' is the non-figurative treatment
// used by aniconic traditions.
interface Props {
  pattern?: 'rays' | 'geometric' | 'bloom';
  variant?: 'scene' | 'ambient';
}
const { pattern = 'rays', variant = 'scene' } = Astro.props;
---

<div
  class={`backdrop backdrop--${variant}`}
  data-pattern={pattern}
  aria-hidden="true"
></div>

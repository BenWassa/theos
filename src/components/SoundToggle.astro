---
// Ambient audio, OFF by default and user-initiated only.
// Browser autoplay policy forbids autoplay-with-sound anyway, and default-off
// is the accessible, public-friendly choice. Renders nothing when no loop is set.
type Props = { src?: string; label?: string };
const { src, label = 'Ambient sound' } = Astro.props;
---

{
  src && (
    <div class="sound">
      <button type="button" data-sound-toggle aria-pressed="false">
        <span class="icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="txt">{label}</span>
      </button>
      <audio data-sound-el src={src} loop preload="none" />
    </div>
  )
}

<style>
  .sound {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 60;
  }
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.85rem;
    background: color-mix(in srgb, #000 55%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, var(--text) 20%, transparent);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
  }
  .icon {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .icon span {
    width: 2px;
    height: 4px;
    background: var(--accent);
    border-radius: 1px;
  }
  button[aria-pressed='true'] .icon span {
    animation: eq 0.9s ease-in-out infinite;
  }
  .icon span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .icon span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes eq {
    0%,
    100% {
      height: 4px;
    }
    50% {
      height: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    button[aria-pressed='true'] .icon span {
      animation: none;
      height: 8px;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  const audio = document.querySelector<HTMLAudioElement>('[data-sound-el]');
  if (btn && audio) {
    audio.volume = 0.35;
    btn.addEventListener('click', async () => {
      const on = btn.getAttribute('aria-pressed') === 'true';
      if (on) {
        audio.pause();
        btn.setAttribute('aria-pressed', 'false');
      } else {
        try {
          await audio.play();
          btn.setAttribute('aria-pressed', 'true');
        } catch {
          /* user can retry; autoplay may be blocked until a gesture */
        }
      }
    });
  }
</script>

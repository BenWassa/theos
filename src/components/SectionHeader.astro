---
// The consistent "chapter opening" every section shares: a hairline rule, the
// slot's icon, its number in the sequence, and a real serif title. This is the
// repeating grammar that orients the long single-scroll read — before this,
// editorial/quote sections opened with only a small floating tag and the
// immersive section had no title at all, so scrolling had no sense of "new
// chapter". Rendered identically above all three module types.
import type { CollectionEntry } from 'astro:content';
import Symbol from './Symbol.astro';
import { SECTION_ICONS, SECTION_MEASURE, type SectionKey } from '../data/sections';

type Props = {
  data: CollectionEntry<'traditions'>['data'];
  total: number;
};
const { data, total } = Astro.props;

const key = data.section as SectionKey;
const icon = SECTION_ICONS[key];
const measure = SECTION_MEASURE[key];
const num = String(data.order).padStart(2, '0');
const count = String(total).padStart(2, '0');
const headingId = `heading-${data.section}`;
---

<header class="section-head reveal" style={`--head-measure:${measure}`}>
  <div class="meta">
    <span class="badge" aria-hidden="true">
      <Symbol name={icon} class="badge-icon" />
    </span>
    <span class="count">{num}<span class="sep">/</span>{count}</span>
  </div>
  <h2 id={headingId} class="display title">{data.title}</h2>
</header>

<style>
  .section-head {
    max-width: var(--head-measure);
    margin: 0 auto clamp(1.9rem, 4.5vh, 3rem);
    padding-top: clamp(1.4rem, 3vh, 2.2rem);
    border-top: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
  }
  /* A short accent tick riding the hairline — the one ember, used sparingly. */
  .section-head {
    position: relative;
  }
  .section-head::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.75rem;
    height: 2px;
    background: var(--accent);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: clamp(1rem, 2.4vh, 1.5rem);
  }
  .badge {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent);
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .badge :global(.badge-icon) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--accent);
  }
  .count {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .sep {
    margin: 0 0.35em;
    opacity: 0.55;
  }

  .title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin: 0;
  }
</style>

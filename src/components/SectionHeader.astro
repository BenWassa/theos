---
// The "chapter opening" every section shares, rendered identically above all
// three module types. An illuminated chapter numeral — a nod to the manuscript
// heritage of sacred books — is the single bold anchor; a hairline divides one
// chapter from the last, and a small eyebrow (slot icon + place in the seven)
// gives orientation without restating the numeral. Before this, editorial and
// quote sections opened with only a floating tag and the immersive section had
// no title at all, so the long single-scroll read had no sense of "new chapter".
import type { CollectionEntry } from 'astro:content';
import Symbol from './Symbol.astro';
import { SECTION_ICONS, SECTION_MEASURE, type SectionKey } from '../data/sections';

type Props = {
  data: CollectionEntry<'traditions'>['data'];
  total: number;
};
const { data, total } = Astro.props;

const key = data.section as SectionKey;
const icon = SECTION_ICONS[key];
const num = String(data.order).padStart(2, '0');
const headingId = `heading-${data.section}`;
---

<header class="section-head reveal" style={`--head-measure:${SECTION_MEASURE}`}>
  <div class="opening">
    <span class="numeral" aria-hidden="true">{num}</span>
    <span class="rule" aria-hidden="true"></span>
    <div class="stack">
      <span class="eyebrow">
        <Symbol name={icon} class="eyebrow-icon" />
        Section {data.order} of {total}
      </span>
      <h2 id={headingId} class="display title">{data.title}</h2>
    </div>
  </div>
</header>

<style>
  .section-head {
    max-width: var(--head-measure);
    margin: 0 auto clamp(1.9rem, 4.5vh, 3rem);
    padding-top: clamp(1.4rem, 3vh, 2.2rem);
    border-top: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
  }

  .opening {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.6rem);
  }
  /* The illuminated capital: the one place the ember is allowed to be loud. */
  .numeral {
    flex: none;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(3rem, 9vw, 4.5rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .rule {
    flex: none;
    align-self: stretch;
    width: 1px;
    background: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .stack {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .eyebrow :global(.eyebrow-icon) {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    color: var(--accent);
  }
  .title {
    font-size: clamp(1.85rem, 4.6vw, 2.5rem);
    margin: 0;
    text-wrap: balance;
  }

  /* Tighten the numeral on narrow screens so the row never crowds the title. */
  @media (max-width: 30rem) {
    .numeral {
      font-size: 2.6rem;
    }
    .opening {
      gap: 0.9rem;
    }
  }
</style>

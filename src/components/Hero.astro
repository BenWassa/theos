---
import Backdrop from './Backdrop.astro';
import type { CollectionEntry } from 'astro:content';
type Props = { meta: CollectionEntry<'meta'>['data'] };
const { meta } = Astro.props;
---

<header class="hero">
  <div class="parallax" data-parallax>
    <Backdrop pattern={meta.pattern} />
  </div>

  <div class="inner">
    <span class="kicker">{meta.hero.kicker}</span>
    <h1 class="display title">{meta.name}</h1>
    <div class="disclaimer">
      <span class="label">Editorial note</span>
      <p>{meta.disclaimer}</p>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true">
    <span></span>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 6rem var(--pad) 4rem;
    overflow: hidden;
    isolation: isolate;
  }
  .parallax {
    position: absolute;
    inset: -10% 0 0 0;
    z-index: 0;
    will-change: transform;
  }
  .inner {
    position: relative;
    z-index: 2;
    max-width: 44rem;
  }
  .kicker {
    display: block;
    margin-bottom: 1.5rem;
  }
  .title {
    font-size: clamp(3.5rem, 12vw, 9rem);
    margin-bottom: 2.5rem;
    text-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
  }
  .disclaimer {
    max-width: 34rem;
    margin: 0 auto;
    background: color-mix(in srgb, #000 45%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
  }
  .disclaimer .label {
    display: block;
    margin-bottom: 0.5rem;
  }
  .disclaimer p {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text);
  }
  .scroll-cue {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: 22px;
    height: 34px;
    border: 1px solid color-mix(in srgb, var(--text) 45%, transparent);
    border-radius: 12px;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 3px;
    height: 7px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue span {
      animation: cue 1.8s var(--ease) infinite;
    }
  }
  @keyframes cue {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    70% {
      transform: translateY(12px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
</style>
